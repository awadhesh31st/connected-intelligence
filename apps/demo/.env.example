# Copy to .env.local for development, or set these in your hosting provider's
# environment variables for production.

# Required — AI provider keys used server-side by the API routes.
GOOGLE_GENERATIVE_AI_API_KEY=
PERPLEXITY_API_KEY=

# Optional — canonical site URL used for metadataBase, sitemap.xml, and
# robots.txt. Defaults to the Vercel preview URL if unset. Set this to your
# production domain (e.g. https://example.com) once one is configured.
NEXT_PUBLIC_SITE_URL=

# Required for the "Ask This Page" backend (device auth + usage quotas).
# Postgres connection string — e.g. from a free Neon project
# (https://neon.tech). Run `pnpm db:migrate` after setting this to create
# the devices/usage_daily tables.
DATABASE_URL=

# Optional but strongly recommended in production — enables real-time burst
# rate limiting on /api/page-qa and /api/extension/register via Upstash
# Redis (https://upstash.com, free tier). Without these two, the app still
# enforces the daily per-device question quota (it lives in Postgres), just
# not the tighter short-window burst limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
