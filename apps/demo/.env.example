# Copy to .env.local for development, or set these in your hosting provider's
# environment variables for production.

# Required — AI provider keys used server-side by the API routes.
GOOGLE_GENERATIVE_AI_API_KEY=
PERPLEXITY_API_KEY=

# Optional — canonical site URL used for metadataBase, sitemap.xml, and
# robots.txt. Defaults to the Vercel preview URL if unset. Set this to your
# production domain (e.g. https://example.com) once one is configured.
NEXT_PUBLIC_SITE_URL=
